gwa() {
  local branch="$1"
  local base="${2:-main}"

  if [ -z "$branch" ]; then
    echo "Usage: gwa <branch-name> [base-branch]"
    return 1
  fi

  local repo_name
  repo_name=$(basename "$(git rev-parse --show-toplevel)")

  git worktree add "../${repo_name}-worktrees/${branch}" -b "${branch}" "${base}"
}
